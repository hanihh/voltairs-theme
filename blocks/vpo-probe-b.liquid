<div {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "Sync probe B",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Place inside a product section. Prices are read from the product's real variants, so what shows here is what checkout charges."
    },
    {
      "type": "header",
      "content": "Delivery mode"
    },
    {
      "type": "text",
      "id": "modes_legend",
      "label": "Group label (screen readers)",
      "default": "Choose a delivery option"
    },
    {
      "type": "checkbox",
      "id": "mode_now_enabled",
      "label": "Enable the express option",
      "info": "Leave off while every order ships on the pre-order timeline.",
      "default": false
    },
    {
      "type": "text",
      "id": "mode_now_label",
      "label": "Express label",
      "default": "Order now"
    },
    {
      "type": "text",
      "id": "mode_now_sub",
      "label": "Express note (when enabled)",
      "default": "Ships within 2 business days"
    },
    {
      "type": "text",
      "id": "mode_now_locked_note",
      "label": "Express note (when disabled)",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "mode_now_ship_text",
      "label": "Express delivery line",
      "info": "Edit this to match your real express timeline before enabling the express option.",
      "default": "Estimated delivery in 2 to 4 business days."
    },
    {
      "type": "paragraph",
      "content": "The shipping lead-in below stays in place for both modes."
    },
    {
      "type": "text",
      "id": "mode_pre_label",
      "label": "Pre-order label",
      "default": "Pre-order the next batch"
    },
    {
      "type": "text",
      "id": "mode_pre_sub",
      "label": "Pre-order note",
      "info": "Use {ship_window} to insert the live date range.",
      "default": "Arrives {ship_window}"
    },
    {
      "type": "text",
      "id": "mode_pre_badge",
      "label": "Pre-order badge",
      "info": "Leave blank while pre-order is the only option. A badge on the sole choice reads as filler."
    },
    {
      "type": "text",
      "id": "modes_note",
      "label": "Reason line",
      "info": "Explains why the first option is closed. Without it a disabled row reads as a broken page.",
      "default": "This batch sold out. Reserve from the next one and it goes out the day it lands with us."
    },
    {
      "type": "header",
      "content": "Delivery window"
    },
    {
      "type": "range",
      "id": "ship_min_days",
      "label": "Earliest delivery",
      "min": 1,
      "max": 40,
      "step": 1,
      "default": 7,
      "unit": "d"
    },
    {
      "type": "range",
      "id": "ship_max_days",
      "label": "Latest delivery",
      "min": 1,
      "max": 60,
      "step": 1,
      "default": 14,
      "unit": "d"
    },
    {
      "type": "select",
      "id": "delivery_icon",
      "label": "Delivery icon",
      "info": "Drawn from the theme icon set, so it inherits the site's single-colour style.",
      "options": [
        {
          "value": "box",
          "label": "Box"
        },
        {
          "value": "check_box",
          "label": "Check box"
        },
        {
          "value": "clipboard",
          "label": "Clipboard"
        },
        {
          "value": "eye",
          "label": "Eye"
        },
        {
          "value": "fire",
          "label": "Fire"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "lightning_bolt",
          "label": "Lightning bolt"
        },
        {
          "value": "lock",
          "label": "Lock"
        },
        {
          "value": "map_pin",
          "label": "Map pin"
        },
        {
          "value": "perfume",
          "label": "Perfume"
        },
        {
          "value": "plane",
          "label": "Plane"
        },
        {
          "value": "price_tag",
          "label": "Price tag"
        },
        {
          "value": "recycle",
          "label": "Recycle"
        },
        {
          "value": "return",
          "label": "Return"
        },
        {
          "value": "ruler",
          "label": "Ruler"
        },
        {
          "value": "shirt",
          "label": "Shirt"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "stopwatch",
          "label": "Stopwatch"
        },
        {
          "value": "truck",
          "label": "Truck"
        },
        {
          "value": "washing",
          "label": "Washing"
        }
      ],
      "default": "truck"
    },
    {
      "type": "text",
      "id": "shipping_highlight",
      "label": "Shipping lead-in",
      "info": "Rendered bold at the front of the delivery line.",
      "default": "Free US shipping."
    },
    {
      "type": "text",
      "id": "shipping_was",
      "label": "Shipping value",
      "info": "Struck through next to the free claim so the saving is visible. Use what you would actually charge, since checkout can be compared against it.",
      "default": "$14.90"
    },
    {
      "type": "text",
      "id": "ship_fallback_text",
      "label": "Delivery line",
      "info": "Use {ship_window} to insert the live date range. Business days only, weekends skipped.",
      "default": "Estimated delivery {ship_window}. Tracking lands in your inbox the moment it ships."
    },
    {
      "type": "header",
      "content": "Offer 1"
    },
    {
      "type": "text",
      "id": "offer_1_variant",
      "label": "Variant ID",
      "info": "Leave blank to use the product's default variant."
    },
    {
      "type": "number",
      "id": "offer_1_qty",
      "label": "Quantity added to cart",
      "default": 1
    },
    {
      "type": "number",
      "id": "offer_1_units",
      "label": "Kits this offer represents",
      "info": "Used for the per-unit price and the savings math.",
      "default": 1
    },
    {
      "type": "text",
      "id": "offer_1_title",
      "label": "Title",
      "default": "1 Kit"
    },
    {
      "type": "text",
      "id": "offer_1_contents",
      "label": "What is in it",
      "default": "2 bags + air pump"
    },
    {
      "type": "text",
      "id": "offer_1_sub",
      "label": "Subtitle",
      "default": "One traveler, one carry-on"
    },
    {
      "type": "text",
      "id": "offer_1_flag",
      "label": "Badge"
    },
    {
      "type": "image_picker",
      "id": "offer_1_image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Offer 2"
    },
    {
      "type": "text",
      "id": "offer_2_variant",
      "label": "Variant ID",
      "info": "Leave blank to use the product's default variant."
    },
    {
      "type": "number",
      "id": "offer_2_qty",
      "label": "Quantity added to cart",
      "default": 2
    },
    {
      "type": "number",
      "id": "offer_2_units",
      "label": "Kits this offer represents",
      "default": 2
    },
    {
      "type": "text",
      "id": "offer_2_title",
      "label": "Title",
      "default": "2 Kits"
    },
    {
      "type": "text",
      "id": "offer_2_contents",
      "label": "What is in it",
      "default": "4 bags + 2 air pumps"
    },
    {
      "type": "text",
      "id": "offer_2_sub",
      "label": "Subtitle",
      "default": "Best for families"
    },
    {
      "type": "text",
      "id": "offer_2_flag",
      "label": "Badge",
      "info": "Usually leave blank. The discount chip already marks this card, and stacking two amber badges next to an amber button spreads the accent too thin."
    },
    {
      "type": "image_picker",
      "id": "offer_2_image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "offer_2_discount_percent",
      "label": "Extra bundle discount",
      "info": "Display only. Create a matching automatic discount in Shopify first, or checkout will charge more than the card shows. Leave at 0 if offer 2 is its own variant with a bundle price.",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "offer_2_save_label",
      "label": "Bundle discount chip",
      "info": "Use {pct} for the percentage.",
      "default": "Extra {pct}% off"
    },
    {
      "type": "select",
      "id": "default_offer",
      "label": "Selected by default",
      "options": [
        {
          "value": "1",
          "label": "Offer 1"
        },
        {
          "value": "2",
          "label": "Offer 2"
        }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "per_unit_word",
      "label": "Per-unit suffix",
      "default": "per kit"
    },
    {
      "type": "header",
      "content": "Add-on"
    },
    {
      "type": "paragraph",
      "content": "A separate product sold alongside the kit. Free with the offer you pick below, a paid opt-in with the other. Both paths add a real line item, so the cart matches the card."
    },
    {
      "type": "checkbox",
      "id": "addon_enabled",
      "label": "Show the add-on",
      "default": true
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Add-on product"
    },
    {
      "type": "text",
      "id": "addon_paid_variant",
      "label": "Paid variant ID",
      "info": "Leave blank to use the product's first variant."
    },
    {
      "type": "text",
      "id": "addon_free_variant",
      "label": "Free variant ID",
      "info": "A $0 variant of the same product, used when the add-on is included. Leave blank to add the paid variant instead and let a Shopify automatic discount zero it out."
    },
    {
      "type": "select",
      "id": "addon_free_with",
      "label": "Free with",
      "options": [
        {
          "value": "1",
          "label": "Offer 1"
        },
        {
          "value": "2",
          "label": "Offer 2"
        },
        {
          "value": "both",
          "label": "Both offers"
        },
        {
          "value": "none",
          "label": "Neither, always paid"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "addon_default_checked",
      "label": "Pre-tick the paid add-on",
      "info": "Off is the safer default. A pre-ticked paid extra surprises people at checkout.",
      "default": false
    },
    {
      "type": "text",
      "id": "addon_eyebrow_free",
      "label": "Eyebrow when free",
      "default": "Free with 2 kits"
    },
    {
      "type": "text",
      "id": "addon_eyebrow_paid",
      "label": "Eyebrow when paid",
      "default": "Add to your order"
    },
    {
      "type": "text",
      "id": "addon_free_word",
      "label": "Word for free",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "addon_title",
      "label": "Title",
      "default": "Smart Travel Planner"
    },
    {
      "type": "text",
      "id": "addon_sub",
      "label": "Subtitle",
      "default": "Drop it on top of the AI you already use and it plans the trip, the packing, and the budget with you."
    },
    {
      "type": "text",
      "id": "providers_label",
      "label": "Compatibility label",
      "default": "Works with the AI you already use"
    },
    {
      "type": "paragraph",
      "content": "Upload each provider's official mark, ideally an SVG or a transparent PNG. A logo replaces the name entirely; without one the name shows as a wordmark. Clear a name to drop it from the row."
    },
    {
      "type": "range",
      "id": "provider_logo_height",
      "label": "Logo height",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "provider_1_name",
      "label": "Provider 1",
      "default": "ChatGPT"
    },
    {
      "type": "image_picker",
      "id": "provider_1_logo",
      "label": "Provider 1 logo"
    },
    {
      "type": "text",
      "id": "provider_2_name",
      "label": "Provider 2",
      "default": "Claude"
    },
    {
      "type": "image_picker",
      "id": "provider_2_logo",
      "label": "Provider 2 logo"
    },
    {
      "type": "text",
      "id": "provider_3_name",
      "label": "Provider 3",
      "default": "Gemini"
    },
    {
      "type": "image_picker",
      "id": "provider_3_logo",
      "label": "Provider 3 logo"
    },
    {
      "type": "text",
      "id": "provider_4_name",
      "label": "Provider 4",
      "default": "Grok"
    },
    {
      "type": "image_picker",
      "id": "provider_4_logo",
      "label": "Provider 4 logo"
    },
    {
      "type": "text",
      "id": "providers_suffix",
      "label": "Trailing text",
      "default": "and more"
    },
    {
      "type": "select",
      "id": "addon_icon",
      "label": "Icon",
      "info": "Drawn from the theme icon set, so it inherits the site's single-colour style.",
      "options": [
        {
          "value": "box",
          "label": "Box"
        },
        {
          "value": "check_box",
          "label": "Check box"
        },
        {
          "value": "clipboard",
          "label": "Clipboard"
        },
        {
          "value": "eye",
          "label": "Eye"
        },
        {
          "value": "fire",
          "label": "Fire"
        },
        {
          "value": "heart",
          "label": "Heart"
        },
        {
          "value": "leaf",
          "label": "Leaf"
        },
        {
          "value": "lightning_bolt",
          "label": "Lightning bolt"
        },
        {
          "value": "lock",
          "label": "Lock"
        },
        {
          "value": "map_pin",
          "label": "Map pin"
        },
        {
          "value": "perfume",
          "label": "Perfume"
        },
        {
          "value": "plane",
          "label": "Plane"
        },
        {
          "value": "price_tag",
          "label": "Price tag"
        },
        {
          "value": "recycle",
          "label": "Recycle"
        },
        {
          "value": "return",
          "label": "Return"
        },
        {
          "value": "ruler",
          "label": "Ruler"
        },
        {
          "value": "shirt",
          "label": "Shirt"
        },
        {
          "value": "star",
          "label": "Star"
        },
        {
          "value": "stopwatch",
          "label": "Stopwatch"
        },
        {
          "value": "truck",
          "label": "Truck"
        },
        {
          "value": "washing",
          "label": "Washing"
        }
      ],
      "default": "map_pin"
    },
    {
      "type": "image_picker",
      "id": "addon_image",
      "label": "Image override",
      "info": "Leave empty to use the icon above."
    },
    {
      "type": "url",
      "id": "addon_link",
      "label": "Product page link"
    },
    {
      "type": "text",
      "id": "addon_link_label",
      "label": "Link label",
      "default": "See how the planner works"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Use {offer} to insert the selected offer's title.",
      "default": "Pre-order {offer}"
    },
    {
      "type": "text",
      "id": "cta_label_express",
      "label": "Button label in express mode",
      "default": "Order {offer} now"
    },
    {
      "type": "text",
      "id": "cta_label_busy",
      "label": "Label while adding",
      "default": "Adding"
    },
    {
      "type": "text",
      "id": "cta_label_done",
      "label": "Label after adding",
      "default": "Added to cart"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "Secure checkout. 100-day money-back guarantee."
    },
    {
      "type": "text",
      "id": "offers_legend",
      "label": "Offers group label (screen readers)",
      "default": "Choose a bundle"
    },
    {
      "type": "header",
      "content": "Stock line"
    },
    {
      "type": "paragraph",
      "content": "Reads live inventory. It stays hidden while stock is above the threshold, so the number always means something."
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Show remaining stock",
      "default": true
    },
    {
      "type": "range",
      "id": "stock_threshold",
      "label": "Show below",
      "min": 5,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "u"
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Stock line",
      "info": "Use {count} for the live number. Requires inventory tracking on the variant.",
      "default": "Only {count} kits left in this pre-order batch."
    },
    {
      "type": "color",
      "id": "stock_dot_color",
      "label": "Stock dot",
      "default": "#c2571c"
    },
    {
      "type": "header",
      "content": "Upsell nudge"
    },
    {
      "type": "paragraph",
      "content": "Shown only while offer 1 is selected. Tapping it switches to offer 2."
    },
    {
      "type": "text",
      "id": "nudge_text",
      "label": "Nudge",
      "info": "Use {pct} for the bundle discount and {bonus} for the add-on title. Leave blank to hide.",
      "default": "Take 2 kits and you get {pct}% off both, plus the {bonus} free instead of paid."
    },
    {
      "type": "text",
      "id": "nudge_action",
      "label": "Action word",
      "default": "Switch"
    },
    {
      "type": "header",
      "content": "Order tagging"
    },
    {
      "type": "paragraph",
      "content": "Added to the cart line so pre-orders are obvious on the order screen."
    },
    {
      "type": "text",
      "id": "property_name",
      "label": "Property name",
      "default": "Fulfilment"
    },
    {
      "type": "text",
      "id": "property_value",
      "label": "Property value (pre-order)",
      "default": "Pre-order"
    },
    {
      "type": "text",
      "id": "property_value_express",
      "label": "Property value (express)",
      "default": "Express"
    },
    {
      "type": "text",
      "id": "dispatch_property_name",
      "label": "Delivery property name",
      "default": "Estimated delivery"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#03275b"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5a6c85"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#d6dbe3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#fdc656"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text",
      "default": "#03275b"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error text",
      "default": "#b3261e"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 14,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Voltairs pre-order offers",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
