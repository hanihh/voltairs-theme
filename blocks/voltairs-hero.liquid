{% doc %}
  Voltairs kinetic hero — the headline gets vacuum-packed. Line 1 renders
  spread out, compresses letter by letter while an amber gauge fills, then
  line 2 stamps in. Plays once per page load; the server-rendered markup is
  the finished state, so no-JS, crawlers, and reduced-motion visitors see a
  complete hero. Rotating-use-case and pattern settings are kept in the
  schema for template compatibility but are not rendered by this design.
{% enddoc %}
{% assign vh_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .vh-{{ vh_id }} {
    position: relative;
    overflow: hidden;
    min-height: {{ block.settings.min_height }}svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(160deg, {{ block.settings.background_color }} 0%, {{ block.settings.background_color | color_darken: 8 }} 100%);
    color: {{ block.settings.text_color }};
    width: 100%;
  }
  .vh-{{ vh_id }} .vh-inner {
    position: relative;
    max-width: 60rem;
    padding: 4rem 1.25rem 4.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .vh-{{ vh_id }} .vh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 1.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: {{ block.settings.text_color | color_modify: 'alpha', 0.75 }};
  }
  .vh-{{ vh_id }} .vh-eyebrow::before {
    content: '';
    width: 26px;
    height: 2px;
    border-radius: 2px;
    background: {{ block.settings.accent_color }};
  }
  .vh-{{ vh_id }} .vh-heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 700;
    line-height: 1.08;
  }
  .vh-{{ vh_id }} .vh-l1,
  .vh-{{ vh_id }} .vh-l2 {
    display: block;
    font-size: clamp(1.4rem, 5.2vw, 4rem);
    letter-spacing: -0.015em;
    white-space: nowrap;
  }
  .vh-{{ vh_id }} .vh-l2 {
    color: {{ block.settings.accent_color }};
    margin-top: 0.1em;
  }
  .vh-{{ vh_id }} .vh-l1 .ch {
    display: inline-block;
    transform: translateX(calc(var(--sp) * 1px));
    transition: transform 1.35s cubic-bezier(0.75, 0, 0.15, 1);
    transition-delay: calc(var(--d) * 1ms);
  }
  .vh-{{ vh_id }}.vh-anim.vh-spread .vh-l1 .ch {
    transition-duration: 0s;
    transition-delay: 0s;
  }
  .vh-{{ vh_id }} .vh-l1.vh-squash {
    animation: vh-squash-{{ vh_id }} 0.5s cubic-bezier(0.4, 0, 0.2, 1) 1;
  }
  @keyframes vh-squash-{{ vh_id }} {
    0% { transform: scaleY(1); }
    45% { transform: scaleY(0.9); }
    100% { transform: scaleY(1); }
  }
  .vh-{{ vh_id }}.vh-anim .vh-l2 {
    opacity: 0;
    transform: scale(1.22);
  }
  .vh-{{ vh_id }}.vh-anim.vh-stamped .vh-l2 {
    opacity: 1;
    transform: scale(1);
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.25, 1), opacity 0.3s ease;
  }
  .vh-{{ vh_id }} .vh-gauge {
    width: min(320px, 60%);
    height: 3px;
    border-radius: 3px;
    background: {{ block.settings.text_color | color_modify: 'alpha', 0.18 }};
    margin-top: 2.1rem;
    overflow: hidden;
  }
  .vh-{{ vh_id }} .vh-gauge i {
    display: block;
    height: 100%;
    width: 100%;
    background: {{ block.settings.accent_color }};
  }
  .vh-{{ vh_id }}.vh-anim .vh-gauge i {
    transform: translateX(-101%);
  }
  .vh-{{ vh_id }}.vh-anim.vh-compressing .vh-gauge i {
    transition: transform 1.5s cubic-bezier(0.75, 0, 0.15, 1);
    transform: translateX(0);
  }
  .vh-{{ vh_id }}.vh-anim.vh-stamped .vh-gauge i {
    transform: translateX(0);
  }
  .vh-{{ vh_id }} .vh-sub {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1.6rem;
  }
  .vh-{{ vh_id }}.vh-anim .vh-sub {
    opacity: 0;
    transform: translateY(8px);
  }
  .vh-{{ vh_id }}.vh-anim.vh-stamped .vh-sub {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s ease 0.15s, transform 0.6s ease 0.15s;
  }
  .vh-{{ vh_id }} .vh-ticks {
    margin: 0 0 1.4rem;
    font-size: 0.85rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: {{ block.settings.text_color | color_modify: 'alpha', 0.74 }};
  }
  .vh-{{ vh_id }} .vh-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    background: {{ block.settings.accent_color }};
    border: 1.5px solid {{ block.settings.accent_color }};
    color: {{ block.settings.background_color }};
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  .vh-{{ vh_id }} .vh-cta:hover {
    background: {{ block.settings.accent_color | color_lighten: 8 }};
    transform: translateY(2px);
  }
  .vh-{{ vh_id }} .vh-cta .vh-arrow {
    display: inline-block;
    animation: vh-bob-{{ vh_id }} 2.2s ease-in-out infinite;
  }
  @keyframes vh-bob-{{ vh_id }} {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vh-{{ vh_id }} .vh-cta .vh-arrow { animation: none; }
    .vh-{{ vh_id }} .vh-l1 .ch { transition: none; }
  }
{% endstyle %}

<div class="vh-{{ vh_id }}" id="vh-{{ vh_id }}" {{ block.shopify_attributes }}>
  <div class="vh-inner">
    {% if block.settings.eyebrow != blank %}
      <p class="vh-eyebrow">{{ block.settings.eyebrow }}</p>
    {% endif %}
    <h1 class="vh-heading" aria-label="{{ block.settings.heading_1 | escape }} {{ block.settings.heading_2 | escape }}">
      <span class="vh-l1" id="vh-l1-{{ vh_id }}" aria-hidden="true">{{ block.settings.heading_1 }}</span>
      {% if block.settings.heading_2 != blank %}
        <span class="vh-l2" aria-hidden="true">{{ block.settings.heading_2 }}</span>
      {% endif %}
    </h1>
    <div class="vh-gauge" aria-hidden="true"><i></i></div>
    <div class="vh-sub">
      {% if block.settings.ticks != blank %}
        <p class="vh-ticks">{{ block.settings.ticks }}</p>
      {% endif %}
      {% if block.settings.cta_label != blank and block.settings.cta_link != blank %}
        <a class="vh-cta" href="{{ block.settings.cta_link }}">
          {{ block.settings.cta_label }}
          <span class="vh-arrow" aria-hidden="true">&darr;</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('vh-{{ vh_id }}');
    var line = document.getElementById('vh-l1-{{ vh_id }}');
    if (!root || !line) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var text = line.textContent;
    var timers = [];

    function split() {
      var chars = Array.prototype.slice.call(text);
      var mid = (chars.length - 1) / 2;
      line.textContent = '';
      chars.forEach(function (c, i) {
        var s = document.createElement('span');
        s.className = 'ch';
        if (c === ' ') {
          s.innerHTML = '&nbsp;';
        } else {
          s.textContent = c;
        }
        s.style.setProperty('--sp', ((i - mid) * 16).toFixed(1));
        s.style.setProperty('--d', String(Math.round(Math.abs(i - mid) * 26)));
        s.style.transform = 'translateX(calc(var(--sp) * 1px))';
        line.appendChild(s);
      });
    }

    /* same choreography and cycle as the approved demo */
    function cycle() {
      timers.forEach(clearTimeout);
      timers = [];
      split();
      line.classList.remove('vh-squash');
      root.className = root.className.replace(/\bvh-(compressing|stamped)\b/g, '');
      root.classList.add('vh-anim', 'vh-spread');
      void root.offsetWidth;

      timers.push(setTimeout(function () {
        root.classList.remove('vh-spread');
        root.classList.add('vh-compressing');
        line.querySelectorAll('.ch').forEach(function (s) {
          s.style.transform = 'translateX(0)';
        });
      }, 700));

      timers.push(setTimeout(function () {
        line.classList.add('vh-squash');
      }, 2050));

      timers.push(setTimeout(function () {
        root.classList.remove('vh-compressing');
        root.classList.add('vh-stamped');
      }, 2250));

      timers.push(setTimeout(cycle, 8200));
    }

    /* start only when the webfont is in and the hero is on screen,
       so the first spread state is what the visitor actually sees */
    function start() {
      if (!('IntersectionObserver' in window)) { cycle(); return; }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          io.disconnect();
          cycle();
        });
      }, { threshold: 0.3 });
      io.observe(root);
    }

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(start);
    } else {
      start();
    }
  })();
</script>

{% schema %}
{
  "name": "Voltairs hero",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Still checking a bag?"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading line 1",
      "default": "10 Days of Clothes."
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading line 2 (stamps in)",
      "default": "One Carry-On."
    },
    {
      "type": "header",
      "content": "Rotating use cases (not used by this design)"
    },
    {
      "type": "text",
      "id": "rotate_prefix",
      "label": "Prefix",
      "default": "Packed for"
    },
    {
      "type": "textarea",
      "id": "rotate_items",
      "label": "Use cases (one per line)",
      "default": "two weeks in Europe\nfamily vacations\nbusiness trips\nfestival weekends\ncarry-on-only travel"
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Seconds per word",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "ticks",
      "label": "Value ticks",
      "default": "60% smaller · airtight & waterproof · zero checked bags"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "See it in action"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#03275b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#efeeeb"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#fdc656"
    },
    {
      "type": "select",
      "id": "pattern_style",
      "label": "Pattern (not used by this design)",
      "options": [
        { "value": "dots", "label": "Dot grid" },
        { "value": "lines", "label": "Diagonal lines" },
        { "value": "none", "label": "None" }
      ],
      "default": "dots"
    },
    {
      "type": "range",
      "id": "pattern_opacity",
      "label": "Pattern opacity",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 50,
      "max": 90,
      "step": 5,
      "default": 70,
      "unit": "svh"
    }
  ],
  "presets": [
    {
      "name": "Voltairs hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
