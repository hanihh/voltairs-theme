

<div
  class="vpo-{{ vpo_id }} vpo-root"
  id="vpo-{{ vpo_id }}"
  data-vpo
  data-product-id="{{ vpo_product.id }}"
  data-ship-min="{{ ship_min }}"
  data-ship-max="{{ ship_max }}"
  data-property-name="{{ block.settings.property_name | escape }}"
  data-property-value="{{ block.settings.property_value | escape }}"
  data-property-value-express="{{ block.settings.property_value_express | escape }}"
  data-dispatch-property="{{ block.settings.dispatch_property_name | escape }}"
  data-mode-pre-sub="{{ block.settings.mode_pre_sub | escape }}"
  data-ship-text="{{ block.settings.ship_fallback_text | escape }}"
  data-ship-text-express="{{ block.settings.mode_now_ship_text | escape }}"
  data-cta-label-express="{{ block.settings.cta_label_express | escape }}"
  {% if addon_live %}
    data-addon-paid-variant="{{ addon_paid.id }}"
    data-addon-free-variant="{{ addon_free.id | default: addon_paid.id }}"
    data-addon-title="{{ block.settings.addon_title | escape }}"
    data-addon-price="{{ addon_price | money | strip_html | escape }}"
    data-addon-free-word="{{ block.settings.addon_free_word | escape }}"
    data-addon-eyebrow-free="{{ block.settings.addon_eyebrow_free | escape }}"
    data-addon-eyebrow-paid="{{ block.settings.addon_eyebrow_paid | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if vpo_product == blank -%}
    <p class="vpo-trust">Add this block inside a product section to see the offers.</p>
  {%- else -%}
    {%- comment -%} Delivery mode {%- endcomment -%}
    <fieldset class="vpo-modes" data-vpo-modes>
      <legend class="vpo-sr">{{ block.settings.modes_legend }}</legend>

      <label class="vpo-mode{% unless block.settings.mode_now_enabled %} vpo-mode--locked{% endunless %}">
        <input
          class="vpo-sr"
          type="radio"
          name="vpo-mode-{{ vpo_id }}"
          value="now"
          {% unless block.settings.mode_now_enabled %}
            disabled
          {% endunless %}
        >
        <span class="vpo-mode-dot" aria-hidden="true"></span>
        <span class="vpo-mode-name">{{ block.settings.mode_now_label }}</span>
        <span class="vpo-mode-sub">
          {%- if block.settings.mode_now_enabled -%}
            {{ block.settings.mode_now_sub }}
          {%- else -%}
            {{ block.settings.mode_now_locked_note }}
          {%- endif -%}
        </span>
      </label>

      <label class="vpo-mode">
        {%- if block.settings.mode_pre_badge != blank -%}
          <span class="vpo-mode-flag">{{ block.settings.mode_pre_badge }}</span>
        {%- endif -%}
        <input
          class="vpo-sr"
          type="radio"
          name="vpo-mode-{{ vpo_id }}"
          value="preorder"
          checked
        >
        <span class="vpo-mode-dot" aria-hidden="true"></span>
        <span class="vpo-mode-name">{{ block.settings.mode_pre_label }}</span>
        <span class="vpo-mode-sub" data-vpo-mode-sub>
          {{- block.settings.mode_pre_sub | replace: '{ship_window}', ship_window_text -}}
        </span>
      </label>
    </fieldset>

    
</div>

{% schema %}
{"name": "Probe F1", "tag": null, "settings": []}
{% endschema %}
