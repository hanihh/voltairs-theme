{% doc %}
  Voltairs benefit chips: four uniform icon + label cells in a grid.
  Replaces nested group/icon/text stacks so every cell renders the
  same size regardless of icon shape or label length.
{% enddoc %}
{% assign vch_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .vch-{{ vch_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    width: 100%;
  }
  @media (max-width: 749px) {
    .vch-{{ vch_id }} { grid-template-columns: repeat(2, 1fr); }
  }
  .vch-{{ vch_id }} .vch-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: {{ block.settings.cell_min_height }}px;
    padding: 12px 10px;
    background: {{ block.settings.cell_background }};
    border-radius: {{ block.settings.corner_radius }}px;
    text-align: center;
  }
  .vch-{{ vch_id }} .vch-icon {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vch-{{ vch_id }} .vch-icon svg,
  .vch-{{ vch_id }} .vch-icon img {
    width: 30px !important;
    height: 30px !important;
    object-fit: contain;
  }
  .vch-{{ vch_id }} .vch-label {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.3;
    text-wrap: balance;
  }
{% endstyle %}

<div class="vch-{{ vch_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..4) %}
    {% assign icon_key = 'icon_' | append: i %}
    {% assign label_key = 'label_' | append: i %}
    {% assign chip_icon = block.settings[icon_key] %}
    {% assign chip_label = block.settings[label_key] %}
    {% if chip_label != blank %}
      <div class="vch-cell">
        <span class="vch-icon">
          {% render 'icon-or-image', icon: chip_icon, width: 30 %}
        </span>
        <p class="vch-label">{{ chip_label }}</p>
      </div>
    {% endif %}
  {% endfor %}
</div>

