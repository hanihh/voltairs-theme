<div {{ block.shopify_attributes }}>
<fieldset class="vpo-modes" data-vpo-modes>
      <legend class="vpo-sr">{{ block.settings.modes_legend }}</legend>

      <label class="vpo-mode{% unless block.settings.mode_now_enabled %} vpo-mode--locked{% endunless %}">
        <input
          class="vpo-sr"
          type="radio"
          name="vpo-mode-{{ vpo_id }}"
          value="now"
          {% unless block.settings.mode_now_enabled %}
            disabled
          {% endunless %}
        >
        <span class="vpo-mode-dot" aria-hidden="true"></span>
        <span class="vpo-mode-name">{{ block.settings.mode_now_label }}</span>
        <span class="vpo-mode-sub">
          {%- if block.settings.mode_now_enabled -%}
            {{ block.settings.mode_now_sub }}
          {%- else -%}
            {{ block.settings.mode_now_locked_note }}
          {%- endif -%}
        </span>
      </label>

      <label class="vpo-mode">
        {%- if block.settings.mode_pre_badge != blank -%}
          <span class="vpo-mode-flag">{{ block.settings.mode_pre_badge }}</span>
        {%- endif -%}
        <input
          class="vpo-sr"
          type="radio"
          name="vpo-mode-{{ vpo_id }}"
          value="preorder"
          checked
        >
        <span class="vpo-mode-dot" aria-hidden="true"></span>
        <span class="vpo-mode-name">{{ block.settings.mode_pre_label }}</span>
        <span class="vpo-mode-sub" data-vpo-mode-sub>
          {{- block.settings.mode_pre_sub | replace: '{ship_window}', ship_window_text -}}
        </span>
      </label>
    </fieldset>
</div>

{% schema %}
{"name": "Probe G1", "tag": null, "settings": []}
{% endschema %}
