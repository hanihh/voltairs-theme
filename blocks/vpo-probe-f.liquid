

<div
  class="vpo-{{ vpo_id }} vpo-root"
  id="vpo-{{ vpo_id }}"
  data-vpo
  data-product-id="{{ vpo_product.id }}"
  data-ship-min="{{ ship_min }}"
  data-ship-max="{{ ship_max }}"
  data-property-name="{{ block.settings.property_name | escape }}"
  data-property-value="{{ block.settings.property_value | escape }}"
  data-property-value-express="{{ block.settings.property_value_express | escape }}"
  data-dispatch-property="{{ block.settings.dispatch_property_name | escape }}"
  data-mode-pre-sub="{{ block.settings.mode_pre_sub | escape }}"
  data-ship-text="{{ block.settings.ship_fallback_text | escape }}"
  data-ship-text-express="{{ block.settings.mode_now_ship_text | escape }}"
  data-cta-label-express="{{ block.settings.cta_label_express | escape }}"
  {% if addon_live %}
    data-addon-paid-variant="{{ addon_paid.id }}"
    data-addon-free-variant="{{ addon_free.id | default: addon_paid.id }}"
    data-addon-title="{{ block.settings.addon_title | escape }}"
    data-addon-price="{{ addon_price | money | strip_html | escape }}"
    data-addon-free-word="{{ block.settings.addon_free_word | escape }}"
    data-addon-eyebrow-free="{{ block.settings.addon_eyebrow_free | escape }}"
    data-addon-eyebrow-paid="{{ block.settings.addon_eyebrow_paid | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if vpo_product == blank -%}
    <p class="vpo-trust">Add this block inside a product section to see the offers.</p>
  {%- else -%}
    {%- comment -%} Delivery mode {%- endcomment -%}
    <fieldset class="vpo-modes" data-vpo-modes>
      <legend class="vpo-sr">{{ block.settings.modes_legend }}</legend>

      <label class="vpo-mode{% unless block.settings.mode_now_enabled %} vpo-mode--locked{% endunless %}">
        <input
          class="vpo-sr"
          type="radio"
          name="vpo-mode-{{ vpo_id }}"
          value="now"
          {% unless block.settings.mode_now_enabled %}
            disabled
          {% endunless %}
        >
        <span class="vpo-mode-dot" aria-hidden="true"></span>
        <span class="vpo-mode-name">{{ block.settings.mode_now_label }}</span>
        <span class="vpo-mode-sub">
          {%- if block.settings.mode_now_enabled -%}
            {{ block.settings.mode_now_sub }}
          {%- else -%}
            {{ block.settings.mode_now_locked_note }}
          {%- endif -%}
        </span>
      </label>

      <label class="vpo-mode">
        {%- if block.settings.mode_pre_badge != blank -%}
          <span class="vpo-mode-flag">{{ block.settings.mode_pre_badge }}</span>
        {%- endif -%}
        <input
          class="vpo-sr"
          type="radio"
          name="vpo-mode-{{ vpo_id }}"
          value="preorder"
          checked
        >
        <span class="vpo-mode-dot" aria-hidden="true"></span>
        <span class="vpo-mode-name">{{ block.settings.mode_pre_label }}</span>
        <span class="vpo-mode-sub" data-vpo-mode-sub>
          {{- block.settings.mode_pre_sub | replace: '{ship_window}', ship_window_text -}}
        </span>
      </label>
    </fieldset>

    {%- if block.settings.modes_note != blank -%}
      <p class="vpo-modes-note">{{ block.settings.modes_note }}</p>
    {%- endif -%}

    {%- comment -%} Offers {%- endcomment -%}
    <fieldset class="vpo-offers">
      <legend class="vpo-sr">{{ block.settings.offers_legend }}</legend>

      {%- for n in (1..2) -%}
        {% liquid
          if n == 1
            assign o_variant = o1_variant
            assign o_qty = o1_qty
            assign o_total = o1_total
            assign o_per_unit = o1_per_unit
            assign o_baseline = o1_baseline
            assign o_chip = ''
            assign o_units = o1_units
            assign o_title = block.settings.offer_1_title
            assign o_sub = block.settings.offer_1_sub
            assign o_contents = block.settings.offer_1_contents
            assign o_flag = block.settings.offer_1_flag
            assign o_image = block.settings.offer_1_image
            assign o_free_addon = free_on_1
            assign o_with_addon = o1_with_addon
          else
            assign o_variant = o2_variant
            assign o_qty = o2_qty
            assign o_total = o2_total
            assign o_per_unit = o2_per_unit
            assign o_baseline = o2_baseline
            assign o_chip = o2_chip
            assign o_units = o2_units
            assign o_title = block.settings.offer_2_title
            assign o_sub = block.settings.offer_2_sub
            assign o_contents = block.settings.offer_2_contents
            assign o_flag = block.settings.offer_2_flag
            assign o_image = block.settings.offer_2_image
            assign o_free_addon = free_on_2
            assign o_with_addon = o2_with_addon
          endif
        %}
        <label class="vpo-offer">
          {%- if o_flag != blank -%}
            <span class="vpo-offer-flag">{{ o_flag }}</span>
          {%- endif -%}
          <input
            class="vpo-sr"
            type="radio"
            name="vpo-offer-{{ vpo_id }}"
            value="{{ n }}"
            data-variant-id="{{ o_variant.id }}"
            data-quantity="{{ o_qty }}"
            data-units="{{ o_units }}"
            data-price="{{ o_total | money | strip_html | escape }}"
            data-price-with-addon="{{ o_with_addon | money | strip_html | escape }}"
            data-title="{{ o_title | escape }}"
            data-free-addon="{% if o_free_addon %}true{% else %}false{% endif %}"
            {% assign n_key = n | append: '' %}
            {% if default_offer == n_key %}
              checked
            {% endif %}
          >

          <span class="vpo-offer-head">
            <span class="vpo-offer-name">{{ o_title }}</span>
            {%- if o_chip != blank -%}
              <span class="vpo-offer-save">{{ o_chip }}</span>
            {%- endif -%}
          </span>

          {%- if o_image != blank -%}
            <span class="vpo-offer-media">
              {{ o_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: o_title }}
            </span>
          {%- endif -%}

          {%- if o_contents != blank -%}
            <span class="vpo-offer-contents">{{ o_contents }}</span>
          {%- endif -%}
          {%- if o_sub != blank -%}
            <span class="vpo-offer-sub">{{ o_sub }}</span>
          {%- endif -%}

          <span class="vpo-price-row">
            <span class="vpo-price">{{ o_total | money }}</span>
            {%- if o_baseline > o_total -%}
              <span class="vpo-price-was">{{ o_baseline | money }}</span>
            {%- endif -%}
          </span>
          {%- if o_units > 1 -%}
            <span class="vpo-price-unit">
              {{- o_per_unit | money }} {{ block.settings.per_unit_word -}}
            </span>
          {%- endif -%}
        </label>
      {%- endfor -%}
    </fieldset>

    {%- comment -%}
      Upsell nudge: spells out what offer 1 leaves behind, and switches for them.
    {%- endcomment -%}
    {%- if nudge_text != blank -%}
      <button class="vpo-nudge" type="button" data-vpo-nudge hidden>
        <span class="vpo-nudge-mark" aria-hidden="true">+</span>
        <span class="vpo-nudge-text">{{ nudge_text }}</span>
        <span class="vpo-nudge-go">{{ block.settings.nudge_action }}</span>
      </button>
    {%- endif -%}

    {%- comment -%}
      Add-on. Free with the qualifying offer, a paid opt-in with the other.
      The checkbox only appears when it costs something.
    {%- endcomment -%}
    {%- if block.settings.addon_enabled -%}
      <div class="vpo-addon {{ addon_state_class }}" data-vpo-addon>
        <label class="vpo-addon-row">
          <input
            class="vpo-sr"
            type="checkbox"
            data-vpo-addon-toggle
            {% if default_free_addon or block.settings.addon_default_checked %}
              checked
            {% endif %}
            {% if default_free_addon %}
              disabled
            {% endif %}
          >
          <span class="vpo-addon-check" aria-hidden="true" data-vpo-addon-check></span>
          <span
            class="vpo-addon-media vpo-addon-media--{% if block.settings.addon_image != blank %}image{% else %}icon{% endif %}"
          >
            {%- render 'icon-or-image',
              icon: block.settings.addon_icon,
              image_upload: block.settings.addon_image,
              width: 18
            -%}
          </span>
          <span class="vpo-addon-body">
            <span class="vpo-addon-eyebrow" data-vpo-addon-eyebrow>
              {{- addon_state_eyebrow -}}
            </span>
            <p class="vpo-addon-title">{{ block.settings.addon_title }}</p>
            {%- if block.settings.addon_sub != blank -%}
              <p class="vpo-addon-sub">{{ block.settings.addon_sub }}</p>
            {%- endif -%}
            {%- capture provider_chips -%}
              {%- for i in (1..4) -%}
                {%- assign name_key = 'provider_' | append: i | append: '_name' -%}
                {%- assign logo_key = 'provider_' | append: i | append: '_logo' -%}
                {%- assign p_name = block.settings[name_key] -%}
                {%- assign p_logo = block.settings[logo_key] -%}
                {%- if p_name != blank -%}
                  {%- comment -%}
                    A logo replaces the wordmark outright. Showing both crowds the
                    row and reads as a badge rather than a compatibility mark.
                  {%- endcomment -%}
                  {%- if p_logo != blank -%}
                    <span class="vpo-logo">
                      {{
                        p_logo
                        | image_url: width: 120
                        | image_tag: loading: 'lazy', alt: p_name, class: 'vpo-logo-img'
                      }}
                    </span>
                  {%- else -%}
                    <span class="vpo-logo vpo-logo--text">{{ p_name }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if provider_chips != blank -%}
              <span class="vpo-addon-compat">
                {%- if block.settings.providers_label != blank -%}
                  <span class="vpo-addon-compat-label">{{ block.settings.providers_label }}</span>
                {%- endif -%}
                <span class="vpo-providers">
                  {{- provider_chips -}}
                  {%- if block.settings.providers_suffix != blank -%}
                    <span class="vpo-logo vpo-logo--more">{{ block.settings.providers_suffix }}</span>
                  {%- endif -%}
                </span>
              </span>
            {%- endif -%}
          </span>
          <span class="vpo-addon-price" data-vpo-addon-price>
            {%- if addon_live -%}
              <span class="vpo-addon-was" data-vpo-addon-was>{{ addon_price | money }}</span>
              <span data-vpo-addon-now>{{ addon_state_price }}</span>
            {%- endif -%}
          </span>
        </label>
        {%- if block.settings.addon_link != blank -%}
          <a class="vpo-addon-link" href="{{ block.settings.addon_link }}">
            {{- block.settings.addon_link_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Ship window {%- endcomment -%}
    <p class="vpo-shipline">
      {%- render 'icon-or-image', icon: block.settings.delivery_icon, width: 18 -%}
      <span>
        {%- if block.settings.shipping_highlight != blank -%}
          <strong class="vpo-shipline-lead">{{ block.settings.shipping_highlight }}</strong>
        {%- endif -%}
        {%- if block.settings.shipping_was != blank -%}
          <span class="vpo-shipline-was">{{ block.settings.shipping_was }}</span>
        {%- endif -%}
        <span data-vpo-shipline>
          {{- block.settings.ship_fallback_text | replace: '{ship_window}', ship_window_text -}}
        </span>
      </span>
    </p>

    {%- if stock_text != blank -%}
      <p class="vpo-stock">
        <span class="vpo-stock-dot" aria-hidden="true"></span>
        {{ stock_text }}
      </p>
    {%- endif -%}

    {%- comment -%} CTA {%- endcomment -%}
    <button
      class="vpo-cta"
      type="button"
      data-vpo-cta
      data-label="{{ block.settings.cta_label | escape }}"
      data-label-busy="{{ block.settings.cta_label_busy | escape }}"
      data-label-done="{{ block.settings.cta_label_done | escape }}"
    >
      <span data-vpo-cta-label>{{ block.settings.cta_label | replace: '{offer}', default_title }}</span>
      <span class="vpo-cta-price" data-vpo-cta-price>{{ default_total | money }}</span>
    </button>

    {%- if block.settings.trust_line != blank -%}
      <p class="vpo-trust">{{ block.settings.trust_line }}</p>
    {%- endif -%}

    <p class="vpo-error" data-vpo-error hidden role="status"></p>
  {%- endif -%}
</div>


{% schema %}
{"name": "Probe F", "tag": null, "settings": []}
{% endschema %}
