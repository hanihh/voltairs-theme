          "blocks": {
            "row_kit": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What's in the kit",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "row_kit_t": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Solo order: 1 compression kit + 1 bonus travel bag.<br/><br/>Family order: 2 compression kits + 2 bonus travel bags + AI Travel Upgrade.<br/><br/>Each compression kit includes one 18.5″ × 11.8″ × 5.9″ vacuum travel bag and one multi-function air pump. The bag fits any carry-on and holds 8 to 10 days of clothes. The pump also inflates air mattresses and pool floats and works as a reading light or emergency torch.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "0.875rem",
                    "line_height": "normal",
                    "letter_spacing": "normal",
                    "case": "none",
                    "wrap": "pretty",
                    "color": "var(--color-foreground)",
