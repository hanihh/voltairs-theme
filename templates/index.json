              },
              "block_order": [
                "row_kit_t"
              ]
            },
            "row_specs": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Specifications",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "row_specs_t": {
                  "type": "text",
                  "settings": {
                    "text": "<ul><li>Bag size: 18.5\" &times; 11.8\" &times; 5.9\"</li><li>Capacity: 18 to 22 lb of clothing per bag</li><li>Compression: down to about 40% of original size, up to 60% space saved</li><li>Shell: anti-rip nylon with an IPX8 water-resistant coating</li><li>Closure: airtight zipper with a D-ring on both sides</li><li>Pump: 30W, USB-C rechargeable, built-in LED light, multiple nozzles</li></ul>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_size": "0.875rem",
