    "section_pdp_cta": {
      "type": "section",
      "blocks": {
        "pcta_heading": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2><strong>Travel With More. Check Less.</strong></h2>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h3",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground-heading)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "pcta_summary": {
          "type": "text",
          "settings": {
