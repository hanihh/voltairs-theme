    "section_pdp_problem": {
      "type": "custom-liquid",
      "name": "The real cost",
      "settings": {
        "custom_liquid": "<section id=\"VoltairsTripSavings\" class=\"voltairs-trip-savings\" aria-labelledby=\"VoltairsTripSavingsTitle\">\n  <div class=\"voltairs-trip-savings__inner\">\n    <header class=\"voltairs-trip-savings__header\">\n      <p class=\"voltairs-trip-savings__eyebrow\">THE REAL COST</p>\n      <h2 id=\"VoltairsTripSavingsTitle\">What You Save in One Trip</h2>\n      <p>Skip the checked bag. Keep the space, money, time, and peace of mind.</p>\n    </header>\n    <div class=\"voltairs-trip-savings__grid\" role=\"list\">\n      <article class=\"voltairs-trip-savings__card\" role=\"listitem\">\n        <div class=\"voltairs-trip-savings__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 7.5h16v11H4zM9 7.5V5h6v2.5M8 11h8M12 7.5v11\"/></svg></div>\n        <p class=\"voltairs-trip-savings__label\">Space saved</p>\n        <p class=\"voltairs-trip-savings__value\">60%</p>\n        <p class=\"voltairs-trip-savings__note\">More room in the same carry-on.</p>\n      </article>\n      <article class=\"voltairs-trip-savings__card\" role=\"listitem\">\n        <div class=\"voltairs-trip-savings__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M14.5 8.5h-3.2a2 2 0 0 0 0 4h1.4a2 2 0 0 1 0 4H9.5M12 6.5v2M12 16.5v2\"/></svg></div>\n        <p class=\"voltairs-trip-savings__label\">Money saved</p>\n        <p class=\"voltairs-trip-savings__value\">$112</p>\n        <p class=\"voltairs-trip-savings__note\">One round-trip checked bag.</p>\n      </article>\n      <article class=\"voltairs-trip-savings__card\" role=\"listitem\">\n        <div class=\"voltairs-trip-savings__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 7.5V12l3 2\"/></svg></div>\n        <p class=\"voltairs-trip-savings__label\">Time saved</p>\n        <p class=\"voltairs-trip-savings__value\">1h 45m+</p>\n        <p class=\"voltairs-trip-savings__note\">45m check-in + 1h carousel. A missing-bag claim can add ~4h.</p>\n      </article>\n      <article class=\"voltairs-trip-savings__card\" role=\"listitem\">\n        <div class=\"voltairs-trip-savings__icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3.5 19 6v5.2c0 4.3-2.9 7.7-7 9.3-4.1-1.6-7-5-7-9.3V6z\"/><path d=\"m8.5 12 2.2 2.2 4.8-5\"/></svg></div>\n        <p class=\"voltairs-trip-savings__label\">Less stress</p>\n        <p class=\"voltairs-trip-savings__value voltairs-trip-savings__value--words\">Bag stays with you</p>\n        <p class=\"voltairs-trip-savings__note\">No check-in line. No missing luggage.</p>\n      </article>\n    </div>\n  </div>\n</section>\n<style>\n  #VoltairsTripSavings{--navy:#03275b;--ink:#14213d;--mist:#f3f5f8;--white:#fff;--gold:#fdc656;background:var(--mist);color:var(--ink);padding:58px 0 64px}\n  #VoltairsTripSavings .voltairs-trip-savings__inner{width:min(1160px,calc(100% - 40px));margin:0 auto}\n  #VoltairsTripSavings .voltairs-trip-savings__header{max-width:720px;margin:0 auto 28px;text-align:center}\n  #VoltairsTripSavings .voltairs-trip-savings__eyebrow{display:inline-block;margin:0 0 10px;padding:8px 11px;border-radius:10px;background:#e8edf5;color:var(--navy);font-size:.75rem;font-weight:800;letter-spacing:.08em;line-height:1}\n  #VoltairsTripSavings h2{margin:0;color:var(--navy);font-size:clamp(2rem,4vw,3.2rem);line-height:1.05}\n  #VoltairsTripSavings .voltairs-trip-savings__header>p:last-child{margin:10px 0 0;color:#4a556d;font-size:1rem;line-height:1.45}\n  #VoltairsTripSavings .voltairs-trip-savings__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}\n  #VoltairsTripSavings .voltairs-trip-savings__card{min-height:230px;padding:24px 22px;border:1px solid rgba(3,39,91,.12);border-top:4px solid var(--navy);border-radius:18px;background:var(--white);box-shadow:0 12px 28px rgba(3,39,91,.06)}\n  #VoltairsTripSavings .voltairs-trip-savings__icon{display:grid;width:42px;height:42px;margin-bottom:20px;place-items:center;border-radius:12px;background:var(--navy);color:var(--gold)}\n  #VoltairsTripSavings .voltairs-trip-savings__icon svg{width:23px;height:23px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.8}\n  #VoltairsTripSavings .voltairs-trip-savings__label{margin:0 0 6px;color:#697389;font-size:.78rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}\n  #VoltairsTripSavings .voltairs-trip-savings__value{margin:0;color:var(--navy);font-size:clamp(2rem,3.1vw,2.75rem);font-weight:800;letter-spacing:-.04em;line-height:1}\n  #VoltairsTripSavings .voltairs-trip-savings__value--words{max-width:12ch;font-size:clamp(1.45rem,2vw,1.9rem);line-height:1.05}\n  #VoltairsTripSavings .voltairs-trip-savings__note{margin:13px 0 0;color:#4e596e;font-size:.92rem;line-height:1.45}\n  @media screen and (max-width:989px){#VoltairsTripSavings .voltairs-trip-savings__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n  @media screen and (max-width:549px){\n    #VoltairsTripSavings{padding:44px 0 48px}\n    #VoltairsTripSavings .voltairs-trip-savings__inner{width:min(100% - 28px,520px)}\n    #VoltairsTripSavings .voltairs-trip-savings__header{margin-bottom:22px;text-align:left}\n    #VoltairsTripSavings .voltairs-trip-savings__grid{grid-template-columns:1fr;gap:10px}\n    #VoltairsTripSavings .voltairs-trip-savings__card{display:grid;min-height:0;padding:18px;grid-template-columns:42px 1fr;column-gap:14px}\n    #VoltairsTripSavings .voltairs-trip-savings__icon{grid-row:1/4;margin:0}\n    #VoltairsTripSavings .voltairs-trip-savings__label,#VoltairsTripSavings .voltairs-trip-savings__value,#VoltairsTripSavings .voltairs-trip-savings__note{grid-column:2}\n    #VoltairsTripSavings .voltairs-trip-savings__value{font-size:1.8rem}\n    #VoltairsTripSavings .voltairs-trip-savings__value--words{font-size:1.35rem}\n    #VoltairsTripSavings .voltairs-trip-savings__note{margin-top:8px}\n  }\n</style>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
